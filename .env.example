# ==============================================================================
# SAVANNA MULTILINGUAL ASSISTANT & LIVE HELP - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting:
# cp .env.example .env

# 1. Google Gemini AI API Key (For Cloud Multilingual RAG & Voice Transcription)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Token (Optional - for live Telegram channel @Savanna_AI_Tutor_Bot)
# Create a bot via @BotFather on Telegram to obtain a token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Africa's Talking SMS API (Optional - for live outbound SMS broadcasting)
# Register a free sandbox developer account at: https://account.africastalking.com/
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here

# 4. Database & Port Configurations (Pre-configured defaults for Docker Compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
SAVANNA_DB_PORT=5435
